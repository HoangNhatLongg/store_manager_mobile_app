<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Cho phep app ket noi den Mobile API cua Next.js. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".UngDungStoreManager"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Store_manager">
        <activity
            android:name=".DangNhap"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:name=".ManHinhTongQuan"
            android:exported="false" />
        <activity
            android:name=".ManHinhSanPham"
            android:exported="false" />
        <activity
            android:name=".ManHinhBanHang"
            android:exported="false" />
        <activity
            android:name=".ManHinhTonKho"
            android:exported="false" />
        <activity
            android:name=".ManHinhDoanhThu"
            android:exported="false" />
        <activity
            android:name=".ManHinhChiTietHoaDon"
            android:exported="false" />
        <activity
            android:name=".ManHinhHoaDonThanhCong"
            android:exported="false" />
        <activity
            android:name=".ManHinhDonViSanPham"
            android:exported="false" />
        <activity
            android:name=".ManHinhDanhMuc"
            android:exported="false" />
        <activity
            android:name=".ManHinhDonViTinh"
            android:exported="false" />
        <activity
            android:name=".ManHinhKhachHang"
            android:exported="false" />
        <activity
            android:name=".ManHinhNhaCungCap"
            android:exported="false" />
        <activity
            android:name=".ManHinhKhoiDong"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider dung de chia se file bao cao CSV cho ung dung khac. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/duong_dan_file_chia_se" />
        </provider>
    </application>

</manifest>
