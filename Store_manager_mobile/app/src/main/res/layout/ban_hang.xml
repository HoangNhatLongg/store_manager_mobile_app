<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Tieu de gon de danh khong gian cho khu vuc POS. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ban_hang"
        android:textColor="@color/xam_chu"
        android:textSize="25sp"
        android:textStyle="bold" />

    <!-- Khu vuc phia tren: 2/3 gio hang, 1/3 tong tien. -->
    <LinearLayout
        android:id="@+id/khu_vuc_gio_hang"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Danh sach mat hang dang cho thanh toan, chiem 2/3 chieu ngang. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="2"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gio_hang_tam_thoi"
                    android:textColor="@color/xam_chu"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="@string/san_pham"
                        android:textColor="@color/xam_phu"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/so_luong_ngan"
                        android:textColor="@color/xam_phu"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="end"
                        android:text="@string/don_gia"
                        android:textColor="@color/xam_phu"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/danh_sach_gio_hang"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/thong_bao_gio_hang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/gio_hang_trong"
                    android:textColor="@color/xam_phu"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tong tien tam tinh, chiem 1/3 chieu ngang. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/xanh_nhat"
            app:cardCornerRadius="16dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tam_tinh"
                    android:textColor="@color/xam_phu"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tong_tien_tam_tinh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="0 ₫"
                    android:textColor="@color/xanh_dam"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tong_so_san_pham"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="0 sản phẩm"
                    android:textColor="@color/xam_phu"
                    android:textSize="11sp" />

                <!-- Chi hien khi nguoi dung chon mot dong trong gio hang. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nut_xoa_mat_hang"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/xoa_mat_hang"
                    android:textColor="#B91C1C"
                    android:visibility="gone"
                    app:cornerRadius="10dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#A7F3D0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nut_tinh_tien"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tinh_tien"
                    android:textSize="12sp"
                    app:backgroundTint="@color/xanh_chu_dao"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Bo loc danh muc va tim kiem nam tren danh sach san pham. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/bo_loc_danh_muc"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="0.9"
            android:background="@drawable/nen_thanh_dieu_huong"
            android:paddingHorizontal="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/khung_tim_san_pham_ban"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:hint="@string/tim_kiem_san_pham"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/o_tim_san_pham_ban"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/danh_sach_san_pham"
        android:textColor="@color/xam_chu"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Danh sach san pham nam o nua duoi man hinh. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/danh_sach_san_pham_ban"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <ProgressBar
        android:id="@+id/vong_tai_ban_hang"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/xanh_chu_dao"
        android:visibility="gone" />
</LinearLayout>
