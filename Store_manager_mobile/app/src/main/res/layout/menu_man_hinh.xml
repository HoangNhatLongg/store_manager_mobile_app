<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/nen_menu"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu"
            android:textColor="@color/xam_chu"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/quan_ly_du_lieu"
            android:textColor="@color/xam_phu"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_san_pham"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:gravity="start|center_vertical"
            android:text="@string/san_pham"
            android:textColor="@color/xam_chu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_nhap_hang"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="@string/nhap_hang"
            android:textColor="@color/xam_chu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_lich_su_nhap"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="@string/lich_su_nhap"
            android:textColor="@color/xam_chu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_lich_su_ban"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="@string/lich_su_ban"
            android:textColor="@color/xam_chu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_doanh_thu"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="@string/quan_ly_doanh_thu"
            android:textColor="@color/xam_chu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_danh_muc"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="@string/quan_ly_danh_muc"
            android:textColor="@color/xam_chu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_don_vi"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="@string/quan_ly_don_vi"
            android:textColor="@color/xam_chu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_khach_hang"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="@string/quan_ly_khach_hang"
            android:textColor="@color/xam_chu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_nha_cung_cap"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="@string/quan_ly_nha_cung_cap"
            android:textColor="@color/xam_chu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_ocr"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="@string/ocr_hoa_don"
            android:textColor="@color/xam_chu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_cai_dat"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="@string/cai_dat"
            android:textColor="@color/xam_chu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_dang_xuat"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:text="@string/dang_xuat"
            android:textColor="#B91C1C" />
    </LinearLayout>
</ScrollView>
