<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/the_san_pham"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Hang tren: khung san pham, ten, gia ban va trang thai. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/nen_khung_san_pham">

                <ImageView
                    android:id="@+id/hinh_san_pham"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/ten_san_pham"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/bieu_tuong_san_pham"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/ten_san_pham"
                    android:src="@drawable/bieu_tuong_san_pham"
                    app:tint="@color/xam_phu" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ten_san_pham"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/xam_chu"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/thong_tin_san_pham"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/xam_phu"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/gia_ban_san_pham"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/xanh_dam"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gia_nhap_san_pham"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/xam_phu"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Canh bao sap het hang, chi hien khi ton kho cham nguong toi thieu. -->
        <LinearLayout
            android:id="@+id/hang_canh_bao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/nen_trang_thai_sap_het"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@string/san_pham_sap_het"
                android:src="@drawable/bieu_tuong_canh_bao"
                app:tint="@color/vang_chu" />

            <TextView
                android:id="@+id/noi_dung_canh_bao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="@color/vang_chu"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hang thong tin: danh muc, so luong ton va trang thai hien an. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/danh_muc_san_pham"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/xam_phu"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/so_luong_ton_san_pham"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/nen_so_luong_ton"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:textColor="#047857"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/trang_thai_san_pham"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/nen_trang_thai_dang_hien"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="#047857"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#F1F5F9" />

        <!-- Cac thao tac, dung icon giong bang thao tac tren web. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/nut_don_vi_san_pham"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/nen_nut_tron"
                android:contentDescription="@string/don_vi_tinh_ngan"
                android:scaleType="centerInside"
                android:src="@drawable/bieu_tuong_don_vi"
                app:tint="@color/xam_phu" />

            <ImageButton
                android:id="@+id/nut_an_san_pham"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/nen_nut_tron"
                android:contentDescription="@string/an_san_pham"
                android:scaleType="centerInside"
                android:src="@drawable/bieu_tuong_an"
                app:tint="@color/xam_phu" />

            <ImageButton
                android:id="@+id/nut_sua_san_pham"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/nen_nut_tron"
                android:contentDescription="@string/sua"
                android:scaleType="centerInside"
                android:src="@drawable/bieu_tuong_sua"
                app:tint="@color/xanh_chu_dao" />

            <ImageButton
                android:id="@+id/nut_xoa_san_pham"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/nen_nut_tron"
                android:contentDescription="@string/xoa"
                android:scaleType="centerInside"
                android:src="@drawable/bieu_tuong_xoa"
                app:tint="@color/do_chu" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
