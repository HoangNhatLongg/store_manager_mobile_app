<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Hang tren: ten san pham va so luong ban. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ten_san_pham_da_ban"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/xam_chu"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/so_luong_san_pham_da_ban"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/nen_o_so_luong"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/xam_chu"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hang thu hai: SKU va danh muc. -->
        <TextView
            android:id="@+id/thong_tin_san_pham_da_ban"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/xam_phu"
            android:textSize="11sp" />

        <!-- Hang cuoi: don gia, thanh tien va loi nhuan. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/don_gia"
                    android:textColor="@color/xam_phu"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/don_gia_san_pham_da_ban"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/xam_phu"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/thanh_tien"
                    android:textColor="@color/xam_phu"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/thanh_tien_san_pham_da_ban"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/xam_chu"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loi_nhuan"
                    android:textColor="@color/xam_phu"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/loi_nhuan_san_pham_da_ban"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
