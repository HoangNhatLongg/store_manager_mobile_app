<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- Tieu de va cac nut hanh dong, giong phan header cua web. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ton_kho_man_hinh"
                    android:textColor="@color/xam_chu"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/mo_ta_ton_kho_man_hinh"
                    android:textColor="@color/xam_phu"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nut_lam_moi_ton_kho"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/lam_moi"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:strokeColor="#CBD5E1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nut_xuat_bao_cao_ton_kho"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/xuat_bao_cao"
                android:textColor="@color/xanh_dam"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/xanh_chu_dao" />
        </LinearLayout>

        <!-- Bon the thong ke ton kho, dung mau sac nhu web. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Tong so san pham. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/nen_thong_ke_tong_san_pham"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="@string/tong_san_pham"
                        android:textColor="#1D4ED8"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/gia_tri_tong_san_pham_ton_kho"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/xam_chu"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- So san pham sap het. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/nen_thong_ke_sap_het"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="@string/sap_het_hang"
                        android:textColor="@color/vang_chu"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/gia_tri_sap_het_ton_kho"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/xam_chu"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- So san pham het hang. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/nen_thong_ke_het_hang"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="@string/het_hang"
                        android:textColor="@color/do_chu"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/gia_tri_het_hang_ton_kho"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/xam_chu"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- So san pham van con hang. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/nen_thong_ke_con_hang"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="@string/con_hang"
                        android:textColor="@color/xanh_dam"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/gia_tri_con_hang_ton_kho"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/xam_chu"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Khu vuc tim kiem va bo loc danh muc. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/khung_tim_kiem_ton_kho"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.5"
                android:hint="@string/tim_kiem_san_pham"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/o_tim_kiem_ton_kho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <Spinner
                android:id="@+id/bo_loc_danh_muc_ton_kho"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/nen_thanh_dieu_huong"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <!-- Cac nut loc trang thai ton kho, dung kieu nut cua web. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nut_loc_tat_ca_ton_kho"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/tat_ca"
                android:textSize="12sp"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nut_loc_con_hang_ton_kho"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/con_hang"
                android:textSize="12sp"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nut_loc_sap_het_ton_kho"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/sap_het_hang"
                android:textSize="12sp"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nut_loc_het_hang_ton_kho"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/het_hang"
                android:textSize="12sp"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Thanh tieu de danh sach va so luong ket qua loc. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danh_sach_ton_kho"
                android:textColor="@color/xam_chu"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/so_luong_ton_kho_hien_thi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/xam_phu"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Thong bao loi khi tai du lieu that bai. -->
        <TextView
            android:id="@+id/thong_bao_loi_ton_kho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/nen_thong_bao_loi"
            android:padding="12dp"
            android:textColor="@color/do_chu"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Danh sach san pham. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/danh_sach_tong_kho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

        <!-- Trang thai rong khi khong co san pham nao khop bo loc. -->
        <TextView
            android:id="@+id/thong_bao_rong_ton_kho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="@string/khong_co_san_pham_ton_kho"
            android:textColor="@color/xam_phu"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Vong tai khi dang tai du lieu. -->
        <ProgressBar
            android:id="@+id/vong_tai_ton_kho"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <!-- Khu vuc phan trang, chi hien khi co nhieu trang. -->
        <LinearLayout
            android:id="@+id/khu_vuc_phan_trang_ton_kho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/mo_ta_phan_trang_ton_kho"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/xam_phu"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nut_trang_truoc_ton_kho"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:text="@string/trang_truoc"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

            <TextView
                android:id="@+id/vi_tri_trang_ton_kho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="@color/xam_chu"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nut_trang_sau_ton_kho"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="@string/trang_sau"
                android:textSize="14sp"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
