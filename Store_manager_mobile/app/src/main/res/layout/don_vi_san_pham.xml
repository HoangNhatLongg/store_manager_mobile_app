<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tieu_de_don_vi_san_pham"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/don_vi_cua_san_pham"
        android:textColor="@color/xam_chu"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ten_san_pham_don_vi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/xam_phu"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nut_them_don_vi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/them_don_vi"
        app:backgroundTint="@color/xanh_chu_dao"
        app:cornerRadius="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/danh_sach_don_vi_san_pham"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />
</LinearLayout>
