<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Noi dung man hinh duoc thay doi boi BoDieuHuongBangTheoManHinh. -->
    <FrameLayout
        android:id="@+id/noi_dung_man_hinh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Thanh dieu huong mobile thay cho sidebar cua web. -->
    <LinearLayout
        android:id="@+id/thanh_dieu_huong"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/nen_thanh_dieu_huong"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nut_dieu_huong_tong_quan"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/tong_quan"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nut_dieu_huong_san_pham"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/san_pham"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nut_dieu_huong_ban_hang"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/ban_hang"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nut_dieu_huong_nhap_hang"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/nhap_hang"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
