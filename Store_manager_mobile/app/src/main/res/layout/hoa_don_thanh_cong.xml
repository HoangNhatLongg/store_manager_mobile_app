<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/xanh_nhat"
        app:cardCornerRadius="22dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/thanh_toan_thanh_cong"
                android:textColor="@color/xanh_dam"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/so_hoa_don_thanh_cong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/xam_chu"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tong_cong_thanh_cong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/xanh_dam"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tien_thua_thanh_cong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/xam_phu"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/thong_bao_da_ton_tai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#FEF3C7"
                android:padding="10dp"
                android:text="@string/thong_bao_hoa_don_da_ton_tai"
                android:textColor="#92400E"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/thong_bao_offline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#DBEAFE"
                android:padding="10dp"
                android:text="@string/thanh_toan_offline"
                android:textColor="#1E40AF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nut_hoan_tat"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="@string/hoan_tat_va_ban_tiep"
        app:backgroundTint="@color/xanh_chu_dao"
        app:cornerRadius="14dp" />
</LinearLayout>
